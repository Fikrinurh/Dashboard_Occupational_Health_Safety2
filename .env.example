# Server & Environment
NODE_ENV="development"
PORT=3000
APP_URL="MY_APP_URL"

# Authentication (JWT)
JWT_SECRET="replace-with-strong-random-32-char-secret"
JWT_EXPIRES_IN="12h"

# MySQL Database Configuration (Standard Local MySQL or Google Cloud SQL for MySQL)
# Leave DB_HOST empty to run in explicit Demo Store mode for preview/testing without a MySQL server.
DB_HOST=""
DB_PORT="3306"
DB_USER="ohs_user"
DB_PASSWORD="replace-with-mysql-password"
DB_NAME="ohs_expert"
DB_CONNECTION_LIMIT="10"
DB_SSL="false"

# Optional Google Cloud SQL Unix Socket Path (e.g. /cloudsql/project:region:instance)
CLOUD_SQL_CONNECTION_NAME=""

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="10"

# Gemini API (if needed server-side)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
